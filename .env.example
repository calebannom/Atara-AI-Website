# Firebase web credentials.
# Firebase web keys are NOT secret (they ship to the browser) — but env vars
# make it easy to swap projects (dev/staging/prod) without editing source.

VITE_FIREBASE_API_KEY=AIzaSyDpPcv5NzL4CnjGY6hvw2Z2j3_7MXTY9ok
VITE_FIREBASE_AUTH_DOMAIN=atara-d21d2.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=atara-d21d2
VITE_FIREBASE_STORAGE_BUCKET=atara-d21d2.firebasestorage.app
VITE_FIREBASE_SENDER_ID=398264780899
VITE_FIREBASE_APP_ID=1:398264780899:web:ff9773ae4bda0a59119056
VITE_FIREBASE_MEASUREMENT_ID=G-DS6R54JH80

# App Check reCAPTCHA Enterprise site key — required in PRODUCTION for
# Firebase AI Logic to work (Firebase enforces App Check on AI Logic
# requests). Create a score-based key at the Google Cloud reCAPTCHA
# Enterprise page, then register it in Firebase console → App Check →
# your web app. Still free (10,000 assessments/month with no billing).
# Leave blank in local dev — a debug token is used automatically instead.
VITE_RECAPTCHA_SITE_KEY=

# AI provider keys — Firebase AI Logic (Gemini Developer API, via your own
# Firebase project) is now the primary provider and needs no key here, only
# App Check set up above. Groq/OpenRouter/Gemini below are fallbacks used
# only if Firebase AI Logic fails. If a key is blank the app falls through
# to the next provider, then to a friendly in-app mock so chat never breaks.

VITE_GROQ_API_KEY=your_groq_key_here
VITE_OPENROUTER_API_KEY=your_openrouter_key_here
VITE_GEMINI_API_KEY=your_gemini_key_here
